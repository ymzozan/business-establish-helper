# Neon connection variables, provisioned through Vercel
KUYUMCU_DATABASE_URL=""
KUYUMCU_DATABASE_URL_UNPOOLED=""

# Authentication
KUYUMCU_AUTH_SECRET=""
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional email integration
RESEND_API_KEY=""

# Public application settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kuyumcu Merkezi"

# Optional new-request email notifications (enable recipient in /panel/ayarlar)
# Keep API keys only in server environment; use a sender on a verified Resend domain.
RESEND_API_KEY=
NOTIFICATION_FROM=
KUYUMCU_PUBLIC_URL=https://kuyumcu-otomasyon.vercel.app
